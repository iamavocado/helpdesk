# DOZZIER HelpDesk Mobile — plantilla de variables de entorno.
# Copia este archivo a .env.development / .env.staging / .env.production
# y completa los valores. NO se versionan los .env.* reales (ver .gitignore).

# Ambiente lógico de la app (development | staging | production)
APP_ENV=development

# URL base de la API REST del cliente (vacío => se usa el mock local)
API_BASE_URL=

# Usar el mock server (MSW) en lugar de la API real (true | false)
USE_MOCK_API=true

# Activar certificate pinning (true en staging/production)
ENABLE_CERT_PINNING=false

# Minutos de inactividad antes del logout automático
INACTIVITY_TIMEOUT_MINUTES=30

# Dominio para el login de la API (campo `dominio` de /api/Auth/login)
DOMINIO=

# Solo para validación local del desarrollador (NO usado por la app).
# Credenciales de prueba para probar la API real desde scripts. Bórralas luego.
DEV_USERNAME=
DEV_PASSWORD=
